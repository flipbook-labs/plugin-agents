--[[
	Action definitions for the example agent plugin.

	Each action is an AgentGateway.Action<Context>. Registered actions show up in
	the manifest (returned by the gateway's `list` method) and can be invoked by
	an agent.

	By the time `run` is called the registry has already validated `params`
	against `inputSchema` (required params present, declared types match, no
	unknown params), so actions only enforce what the schema can't express —
	like non-empty strings and paths that resolve. Errors thrown from `run` are
	caught by the registry and returned to the caller as `{ ok = false, error = ... }`.
]]

local AgentGateway = require("@agentgateway")
local getInstanceFromPath = require("./common/getInstanceFromPath")
local getInstancePath = require("./common/getInstancePath")

local Workspace = game:GetService("Workspace")

export type Context = {
	plugin: Plugin,
}

type Action = AgentGateway.Action<Context>

local function create(_context: Context): { Action }
	return {
		{
			name = "insertPart",
			title = "Insert Part",
			description = "Insert a new anchored Part into the Workspace.",
			inputSchema = {
				type = "object",
				properties = {
					name = { type = "string", description = "Name for the new Part (default: AgentPart)" },
				},
			},
			run = function(_ctx, params)
				local name = params.name

				local part = Instance.new("Part")
				part.Name = if type(name) == "string" and name ~= "" then name else "AgentPart"
				part.Anchored = true
				part.Parent = Workspace

				return { name = part.Name, path = getInstancePath(part) }
			end,
		},

		{
			name = "listInstances",
			title = "List Instances",
			description = "List the children of an instance located by path (defaults to Workspace).",
			inputSchema = {
				type = "object",
				properties = {
					path = { type = "string", description = 'Slash-separated path, e.g. "Workspace/Model"' },
				},
			},
			run = function(_ctx, params)
				local targetPath = params.path

				local target: Instance?
				if type(targetPath) == "string" and targetPath ~= "" then
					target = getInstanceFromPath(targetPath)
					if target == nil then
						error(`no instance at path: {targetPath}`)
					end
				else
					target = Workspace
				end

				assert(target, "target instance resolved to nil")

				local children = {}
				for _, child in target:GetChildren() do
					table.insert(children, { name = child.Name, className = child.ClassName })
				end

				return { path = getInstancePath(target), children = children }
			end,
		},

		{
			name = "renameInstance",
			title = "Rename Instance",
			description = "Rename an instance located by path.",
			inputSchema = {
				type = "object",
				properties = {
					path = { type = "string", description = "Slash-separated path to the instance" },
					name = { type = "string", description = "New name" },
				},
				required = { "path", "name" },
			},
			run = function(_ctx, params)
				local targetPath = params.path :: string
				local name = params.name :: string

				if targetPath == "" then
					error("renameInstance requires a non-empty string 'path'")
				end
				if name == "" then
					error("renameInstance requires a non-empty string 'name'")
				end

				local target = getInstanceFromPath(targetPath)
				if target == nil then
					error(`no instance at path: {targetPath}`)
				end

				local previous = target.Name
				target.Name = name

				return { previous = previous, name = target.Name, path = getInstancePath(target) }
			end,
		},
	}
end

return {
	create = create,
}
